.env
venv/
__pycache__/
*.pyc
storage/chroma_db/
storage/metrics_log.jsonl
# generated by _check_updates.py on every run — the baseline
# (storage/order_watch.json) IS committed, the report is not
storage/order_watch_report.md
.streamlit/secrets.toml
# runtime mirror of pdf-ldf_law for static serving — only the placeholder
# is committed, so the folder exists when the server boots and mounts /static
static/*
!static/.gitkeep
New Text Document.txt
.claude/
# throwaway analysis output (eval logs, probe dumps, frame grabs). Ignored for
# the same reason as docs/ below: push.bat runs `git add .`, so anything left
# here would otherwise ride into the next commit.
scratchpad/

# Design/handoff artifacts — mockups & zips dropped in for reference, not
# source. Ignoring them also stops push.bat's `git add .` from sweeping them
# into a commit (has happened before). No source .html/.zip lives in the repo
# (only new_desing.zip, already tracked).
docs/
*.zip
*.html
# ...except Streamlit component sources — these ARE source and must deploy
!components/**/*.html
# Measurement OUTPUTS are history, not scratch: the frozen grades are the only
# copy of a paired before/after that money was spent on, the ledger is the
# only record of what was spent, and question_parts.json is the yardstick every
# comparison divides by. Losing any of them at a merge already happened once
# (the ledger read $0 instead of $18.30). Only the bulky, regenerable sweeps
# stay out.
night/out/*
!night/out/grades_*.jsonl
!night/out/probe_*.jsonl
!night/out/question_parts.json
!night/out/ledger.json
!night/out/gate*.json
!night/out/*_summary.json
!night/out/anchors_*.jsonl
!night/out/curate_*.jsonl
!night/out/adjudication.json
!night/out/verdicts_*.json
!night/out/rewrites.json
!night/out/wave*_ids.txt
REPORT_corpus.md
