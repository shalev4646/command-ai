# Keep the build context lean and secrets OUT of the image.
.git
.gitignore
venv/
__pycache__/
**/__pycache__/
*.pyc
*.pyo

# Secrets never go in the image — Fly injects them as runtime env/secrets.
.env
.streamlit/secrets.toml

# Rebuilt inside the image at build time (see Dockerfile).
storage/chroma_db/

# static/*.pdf is a mirror of pdf-ldf_law/ and IS what serves the orders list
# now (self-hosting made /app/static/ real — it never worked behind the old
# Streamlit Cloud shell). It stays out of the build CONTEXT because the mirror
# is regenerated inside the image by `python -m pdf_static`, as hard links, so
# shipping the copies would upload and store 52 MB twice.
static/*.pdf

# Local-only noise.
# .claude/ is Claude Code's session data — 151 MB of transcripts that `COPY . .`
# would otherwise bake into the image and re-upload on every deploy.
.claude/
scratchpad/
docs/
*.zip
.DS_Store
Thumbs.db
.vscode/
.idea/
